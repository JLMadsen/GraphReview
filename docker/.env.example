# Copy to docker/.env and fill in real values before `docker compose up`.
# See DESIGN.md §12.

# Bolt URI the app/worker containers use to reach the neo4j service over
# the internal Compose network — normally leave this as-is.
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
# Neo4j requires at least 8 characters.
NEO4J_PASSWORD=changeme-please

# BullMQ/Redis connection over the internal Compose network — normally
# leave this as-is.
REDIS_URL=redis://redis:6379

# Absolute host path bind-mounted read-only into the containers at
# /data/local-repos (§4, §14). Any repo already cloned under this folder
# is usable as a "local" source. Repos elsewhere must be moved/symlinked
# in, or ingested via the app-managed clone-by-URL path instead.
LOCAL_REPOS_PATH=/path/to/your/local/repos

# Key for AES-256-GCM encryption of the GitHub PAT / AI provider API key
# at rest in Neo4j (§11). Use a long random string, e.g.:
#   openssl rand -base64 32
SESSION_SECRET=change-me-to-a-long-random-string

# --- Optional -------------------------------------------------------------
# Everything below has a working default under Docker Compose; set these
# only when running outside Compose or with a non-standard layout.

# Where app-managed clones of URL-based repos live (§12's `repo_cache`
# volume, mounted at /data/repos in both containers). Defaults to
# /data/repos when that directory exists, otherwise ./.data/repos for a
# plain `npm run dev` + `npm run worker` setup outside Docker.
# REPO_CACHE_DIR=/data/repos

# Container-side root that "local path" repos are confined to. Defaults to
# /data/local-repos (where LOCAL_REPOS_PATH above is bind-mounted) when that
# directory exists, otherwise LOCAL_REPOS_PATH itself — so outside Docker
# the same host folder is used directly. Only set this if your mount point
# differs.
# LOCAL_REPOS_ROOT=/data/local-repos

# How many analysis jobs the worker runs at once. Static analysis is
# CPU-bound, so 1 is the sensible default.
# ANALYSIS_CONCURRENCY=1

# Enables a periodic staleness sweep in the worker (milliseconds). §10's
# refresh trigger is "on view", so this is off (0) unless set.
# STALENESS_SWEEP_INTERVAL_MS=0
